ANTHROPIC_API_KEY=
VAULT_MODEL=claude-sonnet-5
# claude | runpod | offline (deterministic, no key, no network)
VAULT_PROVIDER=claude
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL=
VAULT_HOME=~/.vault
# Project whose memory/ mirror the web app writes (hosted mode).
VAULT_PROJECT=.
VAULT_BUDGET=700
