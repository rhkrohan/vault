# Hosted mode environment (PRD section 5).
# Copy to the SERVER's environment. Never commit a filled-in copy; never put
# a real key in the repo, a log or a screenshot.

# --- provider -------------------------------------------------------------
# runpod  : extraction through the RunPod serverless endpoint (hosted mode)
# claude  : extraction through the Anthropic API (local mode)
# offline : deterministic rule-based provider, no key and no network
VAULT_PROVIDER=runpod

# --- RunPod (server environment only) -------------------------------------
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# The model name the endpoint's vLLM worker serves, exactly as the worker
# reports it in /openai/v1/models.
RUNPOD_MODEL=

# --- Claude (only if VAULT_PROVIDER=claude) -------------------------------
ANTHROPIC_API_KEY=
VAULT_MODEL=claude-sonnet-5

# --- storage --------------------------------------------------------------
# BOTH must point outside the container's writable layer (a host volume), or
# a redeploy wipes the memory and "results survive a reload" stops being true.
# VAULT_HOME holds vault.db; VAULT_PROJECT holds the memory/ Markdown mirror.
VAULT_HOME=/data/vault
VAULT_PROJECT=/data/vault-project

# --- retrieval ------------------------------------------------------------
VAULT_BUDGET=700
